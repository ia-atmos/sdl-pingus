;; Spike: comes out when a pingu walks over it, kills the pingus over it
;; at its frame 3, and rests at its frame 13. It is hidden while idle.

func spike_kill (g, pos) {
    loop _, t in g.pingus {
        if in_zone(pos, t.pub, 16-12, 0, 16+12, 32) {
            emit @t :pingu.set [act=:dead]
        }
    }
}

task Spike (g, o) {
    pin pos = [x=o.position@0, y=o.position@1]
    loop {
        await :tick until zone_any(g, pos, 16-5, 0, 16+5, 32)
        par :any {
            await Sprite("traps/spike", pos, [world=true, loop=true])
        } with {
            await :sprite.frame until it.n == 3
            spike_kill(g, pos)
            await :sprite.frame until it.n == 13
        }
    }
}
