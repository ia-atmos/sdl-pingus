;; Bridger: builds up to 15 bricks, and walks up each one.

val BRIDGER_BRICKS = 15

;; The way ahead is free to walk up the bridge.
func bridger_free (p) {
    val blocked = loop _, x in [1, 2, 3, 4] {
        until (rel(p, x, 2) != GP.nothing) || head(p, x, 2), true
    }
    !blocked
}

func bridger_brick (p, left) {
    if left < 4 {
        sound "ting"
    }
    if p.dir == 1 {
        val b = res_surface("other/brick_right")
        val w, h = sdl.size(b)
        ground_put(b, trunc(p.x + 10 - w), trunc(p.y), GP.bridge)
    } else {
        ground_put(res_surface("other/brick_left"), trunc(p.x - 10), trunc(p.y), GP.bridge)
    }
}

;; The offset of the drawing, by the bricks left, as `get_look` of the
;; original: the first bricks are drawn closer to the pingu.
func bridger_off (off, p) {
    val n = BRIDGER_BRICKS - p.bricks
    val x, y = ifs {
        n == 0 => (-4, 0)
        n == 1 => (0, 1)
        n == 2 => (3, 2)
        else   => (6, 4)
    }
    set off.x = -(x * p.dir)
    set off.y = y
}

task Bridger (p, g) {
    ;; as the clocks of the original: a brick takes 15 frames of 66ms
    ;; (30 ticks), placed at the frame 7 (tick 14); a step up takes 4
    ;; frames (8 ticks), and is taken at the next tick
    pin off = [x=0, y=0]
    pin opts = PSPR ++ [off=off]
    set p.bricks = BRIDGER_BRICKS
    bridger_off(off, p)
    loop i {
        do {
            spawn Sprite(pspr(p, "bridger"), p, opts)
            await Ticks(14)
            if i == BRIDGER_BRICKS {
                return :waiter
            }
            if head(p, 0, 2) {
                turn(p)
                return :walker
            }
            bridger_brick(p, BRIDGER_BRICKS - i - 1)
            ;; the brick is placed: one less, as the original counts them
            set p.bricks = BRIDGER_BRICKS - i - 1
            bridger_off(off, p)
            await Ticks(16)
        }
        do {
            spawn Sprite(pspr(p, "bridger_walk"), p, opts)
            await Ticks(9)
        }
        if !bridger_free(p) {
            turn(p)
            return :walker
        }
        set p.x += 4 * p.dir
        set p.y -= 2
    }
}
