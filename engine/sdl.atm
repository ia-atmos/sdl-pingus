;; The platform of the game: the environment `ia-atmos/env-sdl` (a
;; checkout next to this repository, `../env-sdl`, at the commit that the
;; README gives), and what the game adds to it in `engine/pingus.h`:
;; images with modifiers and crops, bitmap fonts, the ground maps, the
;; mover of the pingus.
;;
;; The environment runs the program inside the loop of SDL, which emits,
;; once per frame (see `doc/api.md` of the environment):
;;
;;      :key.dn [key], :key.up [key]            a key was pressed or released
;;      :mouse.motion [x,y]                     the mouse moved
;;      :mouse.button.dn [x,y,button]           a button was pressed (1 left, 3 right)
;;      :mouse.button.up [x,y,button]           a button was released
;;      :quit                                   the window was closed
;;      (time)                                  so that `await 1s` and `:clock` work
;;      :frame [n,us], then :draw               a frame, and its drawing
;;
;; The test mode of the environment, with `SDL_VIDEODRIVER=dummy`:
;; `SDL_ATM_FRAMES=n:ms`, `SDL_ATM_KEYS`, `SDL_ATM_MOUSE`, `SDL_ATM_SHOT`,
;; `SDL_ATM_MUTE`. The game adds `PINGUS_FPS=n` (frames per second) and
;; `PINGUS_COUNT=1` (the number of frames, printed at the end).

include "../../env-sdl/sdl.atm"

```:prelude
#include "engine/pingus.h"
```

val W = 800
val H = 600

sdl.window [
    title   = "Pingus",
    width   = W,
    height  = H,
    logical = [W, H],
    fps     = tonumber(os.getenv("PINGUS_FPS") || "40"),
]

;; The images, by their path, modifier and crop: each one is loaded once.
pin IMGS = []

;; The sounds, by their path.
pin SOUNDS = []

pin pg = [
    ;; pg.img(path, mod [, [cx,cy,cw,ch]]): an image (cropped, then
    ;; rotated or flipped by the modifier), or nil
    img = func (path, mod, c) {
        val cx, cy, cw, ch = if c => (c@0, c@1, c@2, c@3) => (0, 0, 0, 0)
        val k = path ++ "#" ++ tostring(mod) ++ "#" ++ tostring(cx) ++ "," ++
                tostring(cy) ++ "," ++ tostring(cw) ++ "," ++ tostring(ch)
        if IMGS@(k) == nil {
            set IMGS@(k) = `:atmos pg_img_load(pg_cstr($path), pg_int($mod), pg_int($cx), pg_int($cy), pg_int($cw), pg_int($ch))`
        }
        IMGS@(k)
    },

    ;; pg.sound(path [, vol]): plays a sound, loaded once
    sound = func (path, vol) {
        if SOUNDS@(path) == nil {
            set SOUNDS@(path) = sdl.sound(path)
        }
        val snd = SOUNDS@(path)
        if snd {
            sdl.play(snd, if vol == nil => 1.0 => vol)
        }
    },

    ;; fonts: see `font` in `engine/engine.atm`
    font_new = func (size, cs, vs) {
        `:number pg_font_new(pg_int($size), a_dbl($cs), a_dbl($vs))`
    },
    font_glyph = func (f, u, img, x1, y1, x2, y2, ox, oy, adv) {
        `pg_font_glyph(pg_int($f), pg_int($u), $img, pg_int($x1), pg_int($y1), pg_int($x2), pg_int($y2), pg_int($ox), pg_int($oy), pg_int($adv));`
    },
    font_draw = func (f, txt, x, y, origin, a) {
        val alpha = if a == nil => 255 => a
        `pg_font_draw(pg_int($f), pg_cstr($txt), pg_int($x), pg_int($y), pg_int($origin), pg_int($alpha));`
    },
    font_width = func (f, txt) {
        `:number pg_font_width(pg_int($f), pg_cstr($txt))`
    },

    ;; the ground: see `engine/pingus.h`
    map_new = func (w, h) {
        `pg_map_new(pg_int($w), pg_int($h));`
    },
    map_free = func () {
        `pg_map_free();`
    },
    map_get = func (x, y) {
        `:number pg_map_get(pg_int($x), pg_int($y))`
    },
    map_put = func (img, x, y, type) {
        `pg_map_put($img, pg_int($x), pg_int($y), pg_int($type));`
    },
    map_col = func (img, x, y, type) {
        `pg_map_col($img, pg_int($x), pg_int($y), pg_int($type));`
    },
    map_remove = func (gfx, col, x, y) {
        `pg_map_remove($gfx, $col, pg_int($x), pg_int($y));`
    },
    ;; pg.move(x, y, vx, vy, h): the mover of the pingus, in C
    move = func (x, y, vx, vy, h) {
        val hit = `:boolean pg_move(a_dbl($x), a_dbl($y), a_dbl($vx), a_dbl($vy), a_dbl($h))`
        return hit, `:number.float (double)PG_MX`, `:number.float (double)PG_MY`
    },

    ;; pg.f32(x): x rounded to 32 bits, as a `float` of the original
    f32 = func (x) {
        `:number.float (double)(float)a_dbl($x)`
    },

    map_draw = func (x, y) {
        `pg_map_draw(pg_int($x), pg_int($y));`
    },
    map_small = func (x, y, w, h) {
        `pg_map_small(pg_int($x), pg_int($y), pg_int($w), pg_int($h));`
    },
]

;; The number of frames, at the end, for the benchmark.
spawn {
    if os.getenv("PINGUS_COUNT") {
        defer {
            print("frames: " ++ tostring(sdl.frame()))
        }
        await(false)
    }
}

;; The ground types of the collision map.
pin GP = [
    nothing     = 0,
    solid       = 1,
    transparent = 2,
    ground      = 3,
    bridge      = 4,
    water       = 5,
    lava        = 6,
    remove      = 7,
    outofscreen = 8,
]

;; The modifiers of the data files, as numbers.
pin MOD = [
    ROT0 = 0, ROT90 = 1, ROT180 = 2, ROT270 = 3,
    ROT0FLIP = 4, ROT90FLIP = 5, ROT180FLIP = 6, ROT270FLIP = 7,
]
